<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\oledcare.ico</ApplicationIcon>
    <AssemblyName>OledCare</AssemblyName>
    <RootNamespace>OledCare</RootNamespace>
    <Product>OledCare</Product>
    <Description>Webcam ile varlık algılayıp OLED monitörü kapatan/açan Windows uygulaması</Description>
    <Version>0.1.0</Version>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

</Project>
